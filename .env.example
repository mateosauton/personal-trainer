# Manage these in the Expo project's EAS environments as plain text variables.
# Run npm run env:pull to download development values to .env.local.
# This template is for reference or offline setup; it contains no real values.
# Both markers are required and must match. development and preview stay blocked
# until their distinct project references are registered in config/environments.json.
# Use npm run db:local:env for an isolated local Supabase (no production fallback).
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# The publishable key ships in the bundle. Access depends on Supabase RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY

# Google is configured in Supabase and enabled in the EAS app environments.
# Restart Expo or rebuild after changing a provider visibility flag.
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=1
# Apple is skipped. Enable only after completing its provider configuration.
# EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=1

# EXPO_NO_DOTENV=1 disables all Expo dotenv loading. Release commands use it
# and require variables injected by the selected EAS/hosting environment.

# Optional, local testing only. Put these in .env.development.local so a pull
# does not overwrite them. Do not add them to the shared EAS environments.
# The address must be on the whitelist in lib/dev-auth.ts. Use a throwaway
# account; all EXPO_PUBLIC_* values are included in the app bundle.
# Distributable builds reject these variables, even when the flag is zero.
# EXPO_PUBLIC_DEV_LOGIN_EMAIL=you@example.com
# EXPO_PUBLIC_DEV_LOGIN_PASSWORD=your-test-account-password
# EXPO_PUBLIC_ALLOW_DEV_LOGIN=1
