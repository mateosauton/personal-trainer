# Publishable key: safe to ship in the bundle. Every table is RLS'd to
# auth.uid(), so this key alone grants access to nothing.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY

# Optional, testing only. Signs a real test account in with one tap from the
# sign-in screen; the address must also be on the whitelist in lib/dev-auth.ts.
# Leave EXPO_PUBLIC_ALLOW_DEV_LOGIN unset for production builds — EXPO_PUBLIC_*
# values are baked into the shipped bundle. Use a throwaway account.
# EXPO_PUBLIC_DEV_LOGIN_EMAIL=you@example.com
# EXPO_PUBLIC_DEV_LOGIN_PASSWORD=your-test-account-password
# EXPO_PUBLIC_ALLOW_DEV_LOGIN=1
