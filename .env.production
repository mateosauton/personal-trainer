# Committed on purpose. Expo bakes EXPO_PUBLIC_* into the bundle at build time,
# and the Supabase publishable key is designed to ship in a client: every table
# is RLS'd to auth.uid(), so this key on its own grants access to nothing. It
# lives here rather than in a dashboard setting so any checkout builds the same
# app. Loaded only for production builds (`expo export`); `expo start` reads
# .env, which is where a local mock backend goes.
EXPO_PUBLIC_SUPABASE_URL=https://asbudyijvunpnhrhsubm.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_mFljwyuZWXUsGb96egk1QA_Mp1K_ua1
