{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    },
    "release-test": {
      "extends": "production",
      "distribution": "internal",
      "channel": "release-test",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
