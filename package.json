{
  "name": "office-gym-trainer",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@supabase/supabase-js": "^2.109.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-modules-core": "~57.0.15",
    "expo-observe": "~57.0.26",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@electric-sql/pglite": "0.5.11",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.4",
    "babel-jest": "^30.4.1",
    "babel-preset-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "pg": "8.16.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "node scripts/verify-environment.cjs --distribution && EXPO_NO_DOTENV=1 expo export --platform web",
    "check:web": "npm run lint && npm test",
    "lint": "tsc --noEmit",
    "test": "npm run test:safety && node --test tools/dev/serve-dist.test.mjs && npm run test:unit && npm run test:db",
    "test:unit": "jest --runInBand --testTimeout=20000",
    "test:db": "node scripts/test-workout-lifecycle.cjs && node scripts/test-account-isolation.cjs && node scripts/test-session-progression.cjs && node scripts/test-set-ordering.cjs && node scripts/test-session-context.cjs && npm run test:migrations && node scripts/test-database.cjs",
    "catalog": "node scripts/build-catalog.mjs",
    "env:pull": "npx eas-cli@23.2.0 env:pull --environment development",
    "env:pull:preview": "npx eas-cli@23.2.0 env:pull --environment preview",
    "env:pull:production": "npx eas-cli@23.2.0 env:pull --environment production",
    "export:web": "EXPO_NO_DOTENV=1 npx eas-cli@23.2.0 env:exec production 'node scripts/verify-environment.cjs --distribution --environment production && npx expo export --platform web' --non-interactive",
    "docs:verify": "node scripts/verify-docs.mjs",
    "test:migrations": "node --test scripts/test-migration-baseline.cjs",
    "migrations:check": "node scripts/migration-baseline.cjs",
    "env:check": "node scripts/verify-environment.cjs --distribution",
    "build:web:check": "node scripts/check-web-bundle.cjs",
    "test:safety": "node --test config/environment-policy.test.cjs scripts/verify-environment.test.cjs scripts/dev-db.test.cjs scripts/check-web-bundle.test.cjs scripts/release-safety.test.mjs scripts/publish-update.test.cjs",
    "db:local:start": "node scripts/dev-db.cjs start",
    "db:local:stop": "node scripts/dev-db.cjs stop",
    "db:local:env": "node scripts/dev-db.cjs env",
    "db:local:seed": "node scripts/dev-db.cjs seed",
    "db:local:test": "node scripts/dev-db.cjs test",
    "db:local:reset": "node scripts/dev-db.cjs reset",
    "release:native": "node scripts/release-native.mjs",
    "update:preview": "node scripts/publish-update.cjs --channel preview --environment preview",
    "update:candidate": "node scripts/publish-update.cjs --channel release-test --environment production",
    "test:recovery-db": "node scripts/test-workout-lifecycle.cjs && node scripts/test-set-ordering.cjs"
  },
  "private": true
}
